{
  "_note": "Candidate default log locations per client (D24 point 1), relative to the lab user's home. A superset: the inventory on the clean snapshot keeps only the ones that exist, and that result is what the exporter uses. Default verbosity only; no flag that raises it is set by the lab.",
  "claude-code": ["~/.claude/projects/**/*.jsonl", "~/.claude/debug/**", "~/.claude/logs/**", "~/.claude/statsig/**"],
  "codex": ["~/.codex/sessions/**/*.jsonl", "~/.codex/log/**", "~/.codex/logs_*.sqlite", "~/.codex/history.jsonl"],
  "cursor-agent": ["~/.cursor/chats/**", "~/.cursor/agent-cli-state.json", "~/.cursor/logs/**", "~/.local/share/cursor-agent/**/*.log"],
  "gemini": ["~/.gemini/tmp/**/logs.json", "~/.gemini/tmp/**/chats/**", "~/.gemini/logs/**"],
  "goose": ["~/.local/state/goose/logs/**", "~/.local/share/goose/sessions/**", "~/.config/goose/sessions/**"],
  "qwen": ["~/.qwen/tmp/**/logs.json", "~/.qwen/tmp/**/chats/**", "~/.qwen/debug/**", "~/.qwen/logs/**"],
  "vscode-copilot": ["~/.config/Code/logs/**"],
  "cursor-ide": ["~/.config/Cursor/logs/**"]
}
